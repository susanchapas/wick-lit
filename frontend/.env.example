# Browser-facing backend base URL. Keep blank locally so the browser uses Vite's /api proxy.
# Set this only in a production frontend environment, for example:
# VITE_WICK_API_BASE_URL=https://wick-node-c5167eed.azurewebsites.net/api
VITE_WICK_API_BASE_URL=

# Development-only proxy target; this value is never exposed to browser code.
WICK_API_PROXY_TARGET=http://127.0.0.1:7071
